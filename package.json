{
  "name": "chainsetttle-backend",
  "version": "0.1.0",
  "description": "ChainSettle — NestJS backend API for supply chain escrow on Stellar",
  "author": "ChainSettle Team",
  "private": true,
  "license": "MIT",
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "dev:mock-chain": "ts-node test/mocks/stellar-rpc-server.ts",
    "prepare": "husky || true",
    "commitlint": "commitlint --edit",
    "format": "prettier --write \"src/**/*.ts\"",
    "loadtest": "bash load-tests/run-all.sh",
    "check:sdk": "node scripts/check-sdk.js",
    "generate:sdk": "node scripts/generate-sdk.js",
    "dev:up": "docker compose up -d",
    "dev:down": "docker compose down",
    "check:migration": "node scripts/check-prisma-migration.js"
  },
  "dependencies": {
    "@apollo/server": "^4.0.0",
    "@nestjs/apollo": "^12.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/graphql": "^12.0.0",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/mapped-types": "^2.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.1.0",
    "@nestjs/terminus": "^10.1.0",
    "@nestjs/throttler": "^5.0.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^5.6.0",
    "@stellar/stellar-sdk": "^12.0.0",
    "@types/pdfkit": "^0.17.6",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "ajv": "^8.20.0",
    "axios": "^1.16.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "csv-parse": "^5.6.0",
    "dataloader": "^2.2.3",
    "firebase-admin": "^12.0.0",
    "form-data": "^4.0.5",
    "graphql": "^16.0.0",
    "graphql-query-complexity": "^0.12.0",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-subscriptions": "^2.0.0",
    "handlebars": "^4.7.9",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.0",
    "ipfs-http-client": "^60.0.1",
    "joi": "^18.2.3",
    "nest-winston": "^1.10.2",
    "nodemailer": "^6.9.0",
    "passport": "^0.6.0",
    "passport-custom": "^1.1.1",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.18.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^3.0.9",
    "@types/uuid": "^9.0.7",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^9.1.7",
    "jest": "^29.5.0",
    "lint-staged": "^15.2.10",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.0.0",
    "prisma": "^5.6.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 40,
        "branches": 25,
        "functions": 30,
        "lines": 40
      }
    },
    "testEnvironment": "node"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
