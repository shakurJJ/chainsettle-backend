# ============================================================
# ChainSettle Backend — Environment Variables
# Copy this to .env and fill in your values
# Variables marked [required] must be set; others have defaults.
# ============================================================

# ── Server ───────────────────────────────────────────────────
# [optional] Application environment. Values: development | production | test
NODE_ENV=development

# [optional] Port the HTTP server listens on (default: 3000)
PORT=3000

# [optional] Global API route prefix without version (default: api).
# URI versioning appends /v1, /v2 — so routes live at /api/v1/..., /api/v2/...
# Legacy value "api/v1" is still accepted and normalized to "api".
API_PREFIX=api

# [optional] Log level. Values: error | warn | info | http | verbose | debug | silly
# (default: info in production, debug otherwise). Invalid values are rejected at startup.
# LOG_LEVEL=debug

# [optional] Lifetime of admin impersonation JWTs (default: 15m)
IMPERSONATION_JWT_EXPIRES_IN=15m

# ── JWT Auth ─────────────────────────────────────────────────
# [required] Secret used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# [optional] Token lifetime (default: 7d). Accepts zeit/ms format.
JWT_EXPIRES_IN=7d

# ── Database (PostgreSQL via Prisma) ─────────────────────────
# [required] Full PostgreSQL connection string. Must start with postgresql:// or postgres://
# Default for local development with docker-compose: postgresql://chainsetttle:password@localhost:5432/chainsetttle_db
DATABASE_URL=postgresql://chainsetttle:password@localhost:5432/chainsetttle_db

# [optional] Read-replica connection string. When set, list/detail GET handlers query the
# replica instead of the primary. Leave unset for single-DB setups (unchanged behaviour).
# Note: replicas are eventually consistent — a just-created shipment may not appear immediately.
# DATABASE_REPLICA_URL=postgresql://chainsetttle:password@replica-host:5432/chainsetttle_db

# [optional] Max simultaneous connections in the Prisma connection pool (default: 10).
# Increase for high-traffic production deployments; keep low when Postgres has limited max_connections.
DATABASE_CONNECTION_LIMIT=10

# [optional] Seconds Prisma waits for a free connection before throwing (default: 10).
DATABASE_POOL_TIMEOUT=10

# [optional] Move COMPLETED/CANCELLED shipments older than N days into cold storage (default: 90).
# The archival cron runs daily at 03:00 UTC (see ShipmentArchivalJob).
SHIPMENT_ARCHIVAL_DAYS=90
# SHIPMENT_ARCHIVAL_CRON=0 3 * * *

# ── Stellar Network ──────────────────────────────────────────
# [optional] Stellar network to connect to. Values: testnet | mainnet | futurenet (default: testnet)
STELLAR_NETWORK=testnet

# [required] Soroban RPC endpoint for the chosen network
# For local UI work without testnet, run `npm run dev:mock-chain` and use:
# STELLAR_RPC_URL=http://127.0.0.1:8787
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# [required] Horizon REST API endpoint for the chosen network
# With mock chain: STELLAR_HORIZON_URL=http://127.0.0.1:8788
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Optional failover lists (comma-separated, override the single-URL vars above)
# STELLAR_RPC_URLS=https://soroban-testnet.stellar.org,https://rpc-backup.example.com
# STELLAR_HORIZON_URLS=https://horizon-testnet.stellar.org,https://horizon-backup.example.com
# STELLAR_HEALTH_INTERVAL_MS=15000

# [required] Deployed ChainSettle contract ID (set after deploying chainsetttle-contract)
CHAINSETTTLE_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# [required] USDC token contract address on the chosen network
USDC_TOKEN_ADDRESS=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA

# [required] Backend Stellar account secret key (for reading contract events — does NOT hold user funds)
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Email (Nodemailer) ───────────────────────────────────────
# [required] SMTP hostname
SMTP_HOST=smtp.gmail.com

# [optional] SMTP port (default: 587)
SMTP_PORT=587

# [required] SMTP login username
SMTP_USER=your-email@gmail.com

# [required] SMTP login password or app-password
SMTP_PASS=your-app-password

# [required] "From" address on outgoing emails
EMAIL_FROM=noreply@chainsetttle.com

# ── SMS (Twilio) ─────────────────────────────────────────────
# [optional] SMS provider: twilio | logging | none (default: none, disabled)
SMS_PROVIDER=none

# [required if SMS_PROVIDER=twilio] Twilio Account SID
TWILIO_ACCOUNT_SID=

# [required if SMS_PROVIDER=twilio] Twilio Auth Token
TWILIO_AUTH_TOKEN=

# [required if SMS_PROVIDER=twilio] Twilio phone number (E.164 format, e.g., +14155551234)
TWILIO_PHONE_NUMBER=

# ── Rate Limiting ────────────────────────────────────────────
# [optional] Throttler window in seconds (default: 60)
THROTTLE_TTL=60

# [optional] Max requests per window per key (default: 100)
THROTTLE_LIMIT=100

# ── Redis ────────────────────────────────────────────────────
# [required] Redis connection URL (used for rate limiting and nonce storage)
# Default for local development with docker-compose: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── IPFS (Pinata — for pinning proof documents) ──────────────
# [optional] Public IPFS read gateway (default: https://gateway.pinata.cloud/ipfs)
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# [optional] Pinata JWT. Get yours at https://app.pinata.cloud/keys
# Leave empty in development — stub CIDs are returned instead.
IPFS_API_KEY=your-pinata-jwt-token-here

# [optional] How often (ms) to re-check IPFS connectivity after startup (default: 60000)
IPFS_HEALTH_CHECK_INTERVAL_MS=60000

# [optional] Default max upload size in bytes for proof/evidence files (default: 52428800 = 50MB).
# Overridable at runtime by an admin via PATCH /admin/ipfs-config without a redeploy.
IPFS_MAX_UPLOAD_SIZE_BYTES=52428800

# [optional] Comma-separated default allowed MIME types for uploads.
# Overridable at runtime by an admin via PATCH /admin/ipfs-config without a redeploy.
# Leave unset to use the built-in default list (PDF, common image formats, MP4/QuickTime).
IPFS_ALLOWED_MIME_TYPES=

# ── Event Polling ────────────────────────────────────────────
# [optional] How often (ms) to poll Stellar for new contract events (default: 5000)
EVENT_POLLING_INTERVAL_MS=5000

# ── Milestone Deadline Reminders ─────────────────────────────
# [optional] Days after dueAt when the initial overdue notification is sent (default: 0, immediate)
OVERDUE_REMINDER_1_DAYS=0

# [optional] Days after initial reminder when the escalation notification is sent (default: 3)
OVERDUE_REMINDER_3_DAYS=3

# ── Dispute Escalation ───────────────────────────────────────
# [optional] Days a milestone can remain in DISPUTED status before admins are alerted (default: 7)
DISPUTE_ESCALATION_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
# [optional] Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# [optional] Single-origin fallback (used only when ALLOWED_ORIGINS is not set)
CORS_ORIGIN=http://localhost:5173

# ── API Base URL ─────────────────────────────────────────────
# [optional] Base URL of this API — used in email verification links (default: http://localhost:3000)
API_BASE_URL=http://localhost:3000

# ── Development ──────────────────────────────────────────────
# [optional] Queries slower than this threshold (ms) are logged as warnings (default: 100)
SLOW_QUERY_THRESHOLD_MS=100

# ── Firebase Cloud Messaging (FCM mobile push) ───────────────
# [optional] Full service-account JSON (single line, base64 or raw).
# FCM push notifications are disabled when this is absent.
FCM_SERVICE_ACCOUNT_JSON=

# ── Web Push (VAPID — browser push notifications) ────────────
# Generate a key pair once with:  npx web-push generate-vapid-keys
# [optional] VAPID public key (base64url).  Web push is disabled when absent.
VAPID_PUBLIC_KEY=
# [optional] VAPID private key (base64url).  Web push is disabled when absent.
VAPID_PRIVATE_KEY=
# [optional] VAPID subject — must be a mailto: or https: URI (default: mailto:noreply@chainsettle.io)
VAPID_SUBJECT=mailto:noreply@chainsettle.io

# ── OpenTelemetry Tracing ────────────────────────────────────
# [optional] OTLP collector endpoint (must be a valid http(s) URL; validated at startup).  Tracing is FULLY DISABLED when this
# variable is absent — no SDK is initialised and there is no performance
# overhead.  Set it to opt in.
#
# Examples:
#   Jaeger (local dev):  http://localhost:4318
#   Honeycomb:           https://api.honeycomb.io
#   Grafana Tempo:       http://tempo:4318
#
OTEL_EXPORTER_OTLP_ENDPOINT=

# [optional] Service name shown in the trace backend (default: chainsettle-backend)
# Leave unset rather than empty to use the default.
OTEL_SERVICE_NAME=chainsettle-backend

# [optional] Extra OTLP request headers as a JSON object.
# Required by Honeycomb and some other SaaS backends. Must be valid JSON (validated at startup).
# Example: {"x-honeycomb-team":"YOUR_API_KEY","x-honeycomb-dataset":"chainsettle"}
OTEL_EXPORTER_OTLP_HEADERS=

# ── Webhooks ─────────────────────────────────────────────────
# [required for custom headers] 32-byte (exactly 32 chars) AES-GCM key used
# to encrypt webhook custom header values at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex').slice(0,32))"
WEBHOOK_HEADERS_ENCRYPTION_KEY=change-me-webhook-headers-key!!!!
