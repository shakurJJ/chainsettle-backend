// prisma/schema.prisma
// ChainSettle — Database schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS (mirror the on-chain contract enums)
// ============================================================

enum ShipmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  PROOF_SUBMITTED
  CONFIRMED
  DISPUTED
  RESOLVED
}

enum ArbiterStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  DECLINED
}

enum NotificationType {
  SHIPMENT_CREATED
  PROOF_SUBMITTED
  MILESTONE_CONFIRMED
  DISPUTE_RAISED
  DISPUTE_RESOLVED
  DISPUTE_EVIDENCE_SUBMITTED
  SHIPMENT_CANCELLED
  PAYMENT_RELEASED
  MILESTONE_OVERDUE
  COMMENT_ADDED
  COMMENT_MENTION
  SYSTEM_ALERT
  ARBITER_INVITED
  ARBITER_ACCEPTED
  ARBITER_DECLINED
  TRACKING_UPDATED
  PROOF_REJECTED
  DEADLINE_EXTENSION_REQUESTED
  DEADLINE_EXTENSION_DECIDED
  DELIVERY_DELAYED
  SHIPMENT_COMMENT_CREATED
}

enum CommentVisibility {
  ALL
  BUYER_SUPPLIER
  INTERNAL
}

enum DisputeRole {
  BUYER
  SUPPLIER
}

enum ExtensionRequestStatus {
  PENDING
  APPROVED
  DENIED
}

enum UserRole {
  BUYER
  SUPPLIER
  LOGISTICS
  ARBITER
  ADMIN
}

enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

// ============================================================
// MODELS
// ============================================================

model User {
  id               String    @id @default(uuid())
  stellarAddress   String    @unique
  email            String?   @unique
  emailVerified    Boolean   @default(false)
  pendingEmail     String?
  name             String?
  role             UserRole  @default(BUYER)
  deactivatedAt    DateTime? // set when the user deactivates their account (soft-delete)
  kycStatus        KycStatus @default(UNVERIFIED)
  kycReference     String?   // opaque verification reference/ID from the KYC provider — never raw identity documents
  kycVerifiedAt    DateTime?
  kycExpiresAt     DateTime?
  kycReminder30dSentAt DateTime?
  kycReminder7dSentAt  DateTime?
  phoneNumber      String?   // E.164 format (e.g., +14155551234)
  phoneVerified    Boolean   @default(false)
  pendingPhone     String?   // pending verification change
  avatarCid        String?   // IPFS CID of the user's profile avatar
  /// Preferred display currency for converted shipment values.
  /// Validated against SUPPORTED_CURRENCIES in FxRateService.
  /// Defaults to 'USD' so existing users see no behaviour change.
  displayCurrency  String    @default("USD")
  /// Preferred language locale for notifications and emails (#543).
  locale           String    @default("en")

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  buyerShipments     Shipment[]        @relation("BuyerShipments")
  supplierShipments  Shipment[]        @relation("SupplierShipments")
  logisticsShipments Shipment[]        @relation("LogisticsShipments")
  arbiterShipments   Shipment[]        @relation("ArbiterShipments")
  notifications      Notification[]
  auditLogs          AuditLog[]     @relation("AuditLogs")
  disputeEvidence    DisputeEvidence[]
  comments           ShipmentComment[]
  shipmentNotes      ShipmentNote[]
  trackingUpdates    TrackingUpdate[]
  shipmentTemplates  ShipmentTemplate[] @relation("ShipmentTemplates")
  webhookEndpoints      WebhookEndpoint[]
  apiKeys     ApiKey[]
  deviceTokens DeviceToken[]
  notificationPreference NotificationPreference?
  webPushSubscriptions   WebPushSubscription[]
  shipmentWatchers ShipmentWatcher[] @relation("ShipmentWatchers")
  shipmentFavorites ShipmentFavorite[] @relation("ShipmentFavorites")
  sentInvitations     ShipmentInvitation[] @relation("SentInvitations")
  acceptedInvitations ShipmentInvitation[] @relation("AcceptedInvitations")
  savedFilters      SavedFilter[]      @relation("SavedFilters")
  organizationMemberships OrganizationMember[]
  createdOrganizations    Organization[]       @relation("OrganizationCreator")
  announcementDismissals AnnouncementDismissal[]
  contacts           Contact[]
  shipmentReminders ShipmentReminder[] @relation("ShipmentReminders")
  recurringSchedules RecurringSchedule[] @relation("RecurringSchedules")

  @@index([kycExpiresAt])
  @@map("users")
}

enum AnnouncementSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Admin-managed platform banner (#426). Shown while startsAt <= now < endsAt
/// to users whose role is in audienceRoles (empty = everyone).
model Announcement {
  id            String               @id @default(uuid())
  title         String
  body          String
  severity      AnnouncementSeverity @default(INFO)
  startsAt      DateTime
  endsAt        DateTime?
  audienceRoles UserRole[]           @default([])
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  dismissals AnnouncementDismissal[]

  @@index([startsAt, endsAt])
  @@map("announcements")
}

model AnnouncementDismissal {
  announcementId String
  userId         String
  dismissedAt    DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId])
  @@map("announcement_dismissals")
}

model Shipment {
  id               String          @id  // matches on-chain shipment_id
  buyerAddress     String
  supplierAddress  String
  logisticsAddress String
  arbiterAddress   String
  tokenAddress     String
  totalAmount      BigInt          // stored in stroops (smallest unit)
  releasedAmount   BigInt          @default(0)
  status           ShipmentStatus  @default(ACTIVE)
  arbiterStatus    ArbiterStatus   @default(PENDING_ACCEPTANCE)
  txHash           String?         // ledger tx hash of creation
  createdLedger    Int?            // ledger sequence at creation

  // Token metadata (populated from TokenRegistry at creation time)
  tokenDecimals    Int     @default(7)
  tokenSymbol      String  @default("USDC")

  // Human-readable context fields
  description      String?         // what goods are being shipped (max 1000 chars)
  description_search Unsupported("tsvector")?
  referenceNumber  String?         @unique // contract/PO reference for external systems
  metadata         Json?           // arbitrary key-value pairs (incoterms, port, etc)
  tags             String[]        @default([]) // searchable tags
  expectedDeliveryAt DateTime?     // promised delivery date/time

  // Cancellation / refund tracking
  cancelledAt      DateTime?       // set when shipment is cancelled on-chain
  refundTxHash     String?         // tx hash of the on-chain cancellation

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relations
  buyer     User        @relation("BuyerShipments", fields: [buyerAddress], references: [stellarAddress])
  supplier  User        @relation("SupplierShipments", fields: [supplierAddress], references: [stellarAddress])
  logistics User        @relation("LogisticsShipments", fields: [logisticsAddress], references: [stellarAddress])
  arbiter   User        @relation("ArbiterShipments", fields: [arbiterAddress], references: [stellarAddress])
  milestones Milestone[]
  events    ChainEvent[]
  comments  ShipmentComment[]
  shipmentNotes ShipmentNote[]
  trackingUpdates TrackingUpdate[]
  watchers  ShipmentWatcher[]
  favorites ShipmentFavorite[]
  approvals ShipmentApproval[]
  reminders ShipmentReminder[]

  isDraft          Boolean         @default(false) // true when created via CSV bulk import; no on-chain backing yet

  @@index([buyerAddress, status, createdAt])
  @@index([supplierAddress, status, createdAt])
  @@index([updatedAt])
  @@map("shipments")
}

model Contact {
  id             String   @id @default(uuid())
  ownerId        String
  stellarAddress String
  label          String
  defaultRole    UserRole?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, stellarAddress])
  @@index([ownerId, label])
  @@map("contacts")
}

model Milestone {
  id                 String          @id @default(uuid())
  shipmentId         String
  milestoneIndex     Int             // 0-based index matching on-chain
  name               String
  paymentPercent     Int             // 0-100
  proofHash          String?         // IPFS CID submitted by supplier/logistics
  status             MilestoneStatus @default(PENDING)
  paymentReleased    BigInt?         // exact amount released for this milestone
  confirmedAt        DateTime?
  dueAt              DateTime?       // optional deadline for milestone completion
  overdueNotifiedAt  DateTime?       // timestamp when overdue notification was sent (prevents re-notification)
  overdueReminder3dAt DateTime?       // timestamp when 3-day escalation notification was sent
  disputeEscalatedAt DateTime?       // set when the dispute has been escalated to admins (prevents re-escalation)
  disputedAt         DateTime?       // when the milestone entered DISPUTED status
  deletedAt          DateTime?       // soft-delete marker; set by DELETE /shipments/:id/milestones/:index (#306)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  // Relations
  shipment        Shipment          @relation(fields: [shipmentId], references: [id])
  disputeEvidence DisputeEvidence[]
  proofSubmissions ProofSubmission[]
  settlementProposals SettlementProposal[]
  checklistItems MilestoneChecklistItem[]
  extensionRequests DeadlineExtensionRequest[]

  @@unique([shipmentId, milestoneIndex])
  @@index([dueAt])
  @@map("milestones")
}

/// Proof expected for a milestone (e.g. "bill of lading"). Defined by the
/// buyer while the milestone is PENDING; ticked off by supplier/logistics (#392).
model MilestoneChecklistItem {
  id          String    @id @default(uuid())
  milestoneId String
  label       String    @db.VarChar(200)
  required    Boolean   @default(true)
  completedAt DateTime?
  completedBy String?   // Stellar address
  createdAt   DateTime  @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@map("milestone_checklist_items")
}

/// Supplier/logistics request to move a milestone's dueAt; decided by the buyer (#393).
model DeadlineExtensionRequest {
  id            String                 @id @default(uuid())
  milestoneId   String
  requestedBy   String                 // Stellar address
  proposedDueAt DateTime
  previousDueAt DateTime?
  reason        String                 @db.VarChar(1000)
  status        ExtensionRequestStatus @default(PENDING)
  decidedAt     DateTime?
  decidedBy     String?                // Stellar address
  createdAt     DateTime               @default(now())

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId, status])
  @@map("deadline_extension_requests")
}

model ProofSubmission {
  id          String   @id @default(uuid())
  milestoneId String
  ipfsCid     String   // IPFS CID of the uploaded proof
  submittedBy String   // Stellar address of whoever uploaded
  sha256      String?  // hex SHA-256 of the uploaded file (#394); null for pre-migration rows
  fileSize    Int?     // size in bytes of the uploaded file (#394)
  createdAt   DateTime @default(now())

  // Relations
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@index([submittedBy])
  @@index([sha256])
  @@map("proof_submissions")
}

model DisputeEvidence {
  id          String      @id @default(uuid())
  milestoneId String
  submittedBy String      // Stellar address
  role        DisputeRole // BUYER or SUPPLIER
  description String      @db.Text
  ipfsCid     String?     // IPFS hash of uploaded file
  fileName    String?     // Original filename
  fileSize    Int?        // File size in bytes
  mimeType    String?     // MIME type of file
  createdAt   DateTime    @default(now())

  // Relations
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [submittedBy], references: [stellarAddress])

  @@index([milestoneId])
  @@index([submittedBy])
  @@map("dispute_evidence")
}

model ChainEvent {
  id          String   @id @default(uuid())
  shipmentId  String?
  eventName   String   // e.g. "shipment_created", "milestone_confirmed"
  ledger      Int
  txHash      String
  payload     Json     // raw event payload from Stellar
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  @@unique([txHash, eventName])
  @@index([shipmentId])
  @@index([eventName])
  @@index([processed])
  @@index([ledger])
  @@map("chain_events")
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  type       NotificationType
  title      String
  message    String
  data       Json?            // extra context (shipmentId, amount, etc.)
  read         Boolean          @default(false)
  emailSent    Boolean          @default(false)
  deliverAfter DateTime?
  snoozedUntil DateTime?        // set by the user; excluded from list while snoozedUntil > now()
  createdAt    DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([read])
  @@map("notifications")
}


enum SettlementProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model SettlementProposal {
  id              String                   @id @default(uuid())
  milestoneId     String
  proposedBy      String
  supplierPercent Int
  message         String?
  status          SettlementProposalStatus @default(PENDING)
  respondedAt     DateTime?
  createdAt       DateTime                 @default(now())
  milestone       Milestone                @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId, status])
  @@map("settlement_proposals")
}
model EventCursor {
  id                  String   @id
  lastProcessedLedger Int
  updatedAt           DateTime @updatedAt

  @@map("event_cursors")
}

enum BackfillStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

/// Tracks a single admin-initiated ledger-range event backfill.
/// Only one row may be in PENDING or RUNNING state at a time.
model BackfillRun {
  id             String        @id @default(uuid())
  status         BackfillStatus @default(PENDING)
  fromLedger     Int
  toLedger       Int
  processedCount Int           @default(0)  // events successfully processed
  errorCount     Int           @default(0)  // events that failed handler execution
  currentLedger  Int?                       // last ledger polled (progress indicator)
  errorSummary   Json?                      // array of { ledger, txHash, eventName, error }
  startedAt      DateTime      @default(now())
  completedAt    DateTime?
  initiatedBy    String?                    // Stellar address of the admin who triggered it

  @@index([status])
  @@index([startedAt])
  @@map("backfill_runs")
}

model FailedEvent {
  id            String    @id @default(uuid())
  eventName     String
  ledger        Int
  txHash        String
  payload       Json
  error         String    @db.Text
  attemptCount  Int       @default(1)
  lastAttemptAt DateTime  @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([txHash, eventName])
  @@index([resolvedAt])
  @@map("failed_events")
}

model ShipmentComment {
  id            String            @id @default(uuid())
  shipmentId    String
  authorId      String
  body          String            @db.VarChar(2000)
  visibility    CommentVisibility @default(ALL)
  attachmentCid String?
  pinnedAt      DateTime?         // set when pinned; null when unpinned (max 3 per shipment)
  parentCommentId String?         // set when this comment is a reply to another comment (#299)
  milestoneIndex  Int?            // optional milestone this comment is scoped to (#396)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  deletedAt     DateTime?

  shipment Shipment          @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  author   User              @relation(fields: [authorId], references: [id])
  parent   ShipmentComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies  ShipmentComment[] @relation("CommentReplies")

  @@index([shipmentId])
  @@index([authorId])
  @@index([parentCommentId])
  @@index([shipmentId, milestoneIndex])
  @@map("shipment_comments")
}

model ShipmentNote {
  id         String   @id @default(uuid())
  shipmentId String
  authorId   String
  body       String   @db.VarChar(2000)
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id])

  @@index([shipmentId])
  @@index([authorId])
  @@map("shipment_notes")
}

model TrackingUpdate {
  id               String    @id @default(uuid())
  shipmentId       String
  submittedBy      String
  location         String    // e.g. "Port of Lagos"
  latitude         Float?
  longitude        Float?
  status           String    // e.g. "In Transit", "Customs Clearance", "Out for Delivery"
  estimatedArrival DateTime?
  notes            String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [submittedBy], references: [stellarAddress])

  @@index([shipmentId])
  @@index([submittedBy])
  @@index([createdAt])
  @@map("tracking_updates")
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String
  actorId        String?
  actorAddress   String?
  action         String
  entityType     String
  entityId       String?
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  user User @relation("AuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  preferences     Json     // Record<NotificationType, { inApp: boolean; email: boolean; slack: boolean; sms: boolean; discord: boolean }>
  slackWebhookUrl String?  // Incoming Slack webhook URL; null disables Slack delivery
  discordWebhookUrl String? // Incoming Discord webhook URL; null disables Discord delivery
  smsSentCount    Int      @default(0)   // SMS sent this rolling 24h window
  smsWindowStart  DateTime @default(now()) // Start of current 24h rate-limit window
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model WebhookEndpoint {
  id         String    @id @default(uuid())
  userId     String
  url        String
  secret     String    // SHA-256 hash of the plaintext signing secret
  events     String[]  // NotificationType values this endpoint subscribes to
  headers    Json?     // Encrypted custom headers: { "name": "encrypted-value", ... }
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([userId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id                  String    @id @default(uuid())
  endpointId          String
  eventType           String
  payload             Json
  statusCode          Int?
  responseBody        String?
  deliveredAt         DateTime?
  nextRetryAt         DateTime?
  attemptCount        Int       @default(0)
  /// Set when all retry attempts are exhausted — delivery is permanently failed.
  permanentlyFailedAt DateTime?
  createdAt           DateTime  @default(now())

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([endpointId])
  @@index([nextRetryAt])
  @@index([permanentlyFailedAt])
  @@map("webhook_deliveries")
}

model ReconciliationRun {
  id            String    @id @default(uuid())
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  checkedCount  Int       @default(0)
  mismatchCount Int       @default(0)
  errors        Json?

  @@map("reconciliation_runs")
}

model ShipmentTemplate {
  id                String   @id @default(uuid())
  ownerId           String
  name              String
  description       String?
  supplierAddress   String?
  logisticsAddress  String?
  arbiterAddress    String?
  tokenAddress      String?
  milestoneTemplates Json    // array of { name, paymentPercent, dueDays?, checklist?: { label, required? }[] }
  isPublic          Boolean  @default(false)
  deletedAt         DateTime? // soft-delete marker; set by DELETE /shipment-templates/:id (#306)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  owner User @relation("ShipmentTemplates", fields: [ownerId], references: [id], onDelete: Cascade)
  recurringSchedules RecurringSchedule[]

  @@index([ownerId])
  @@index([isPublic])
  @@map("shipment_templates")
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  keyHash     String    @unique  // SHA-256 hash of the plaintext key
  name        String             // human label e.g. "CI Pipeline"
  scopes      String[]  @default(["read", "write"]) // allowed: "read", "write"
  lastUsedAt  DateTime?
  expiresAt   DateTime?          // null = never expires; set = key expires at this time
  expiryWarningSentAt DateTime?  // set when the 7-day warning notification was sent (prevents duplicates)
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?          // null = active, set = revoked
  rotatedFromId   String?        // ID of the predecessor key this was rotated from
  gracePeriodEndsAt DateTime?    // when set, the revoked predecessor key is still valid until this time

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
  @@index([userId])
  @@index([expiresAt])
  @@index([gracePeriodEndsAt])
  @@map("api_keys")
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique // push service URL (acts as the device identity)
  p256dh    String   // client public key (base64url)
  auth      String   // auth secret (base64url)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("web_push_subscriptions")
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique // FCM registration token
  platform  String   @default("fcm") // "fcm" (covers Android + iOS via FCM)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model AppConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

/// A single co-approver signing off on a high-value shipment. Milestone
/// confirmation is blocked until the shipment has `requiredApprovals` rows
/// here. One row per approver address, enforced by the unique constraint.
/// A named, reusable set of GET /shipments filter criteria, private to the
/// user who created it. `filter` holds only filter fields; pagination is a
/// per-request concern and is never stored.
model SavedFilter {
  id        String   @id @default(uuid())
  userId    String
  name      String
  filter    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("SavedFilters", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
  @@map("saved_filters")
}

model ShipmentApproval {
  id              String   @id @default(uuid())
  shipmentId      String
  approverAddress String
  note            String?
  createdAt       DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, approverAddress])
  @@index([shipmentId])
  @@map("shipment_approvals")
}

model ShipmentFavorite {
  id         String   @id @default(uuid())
  shipmentId String
  userId     String
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user     User     @relation("ShipmentFavorites", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, userId])
  @@index([userId])
  @@map("shipment_favorites")
}

model ShipmentWatcher {
  id         String   @id @default(uuid())
  shipmentId String
  userId     String
  createdAt  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user     User     @relation("ShipmentWatchers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, userId])
  @@index([userId])
  @@map("shipment_watchers")
}


/// Cold-storage copy of a COMPLETED/CANCELLED shipment moved out of the hot
/// `shipments` table by the scheduled archival job. `payload` retains the full
/// relational snapshot (milestones, events, comments, tracking, notes, evidence).
model ArchivedShipment {
  id               String         @id // original shipment id
  status           ShipmentStatus
  buyerAddress     String
  supplierAddress  String
  logisticsAddress String
  arbiterAddress   String
  referenceNumber  String?
  terminalAt       DateTime       // when shipment became COMPLETED/CANCELLED
  archivedAt       DateTime       @default(now())
  payload          Json           // full history snapshot for compliance/reference

  @@index([buyerAddress])
  @@index([supplierAddress])
  @@index([logisticsAddress])
  @@index([arbiterAddress])
  @@index([status])
  @@index([archivedAt])
  @@index([terminalAt])
  @@map("archived_shipments")
}

/// Invitation for a counterparty who has no account yet (#379).
/// Only the SHA-256 hash of the single-use token is stored.
model ShipmentInvitation {
  id           String    @id @default(uuid())
  shipmentId   String?
  templateId   String?
  email        String
  role         UserRole
  tokenHash    String    @unique
  invitedById  String
  acceptedById String?
  acceptedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  invitedBy  User  @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("AcceptedInvitations", fields: [acceptedById], references: [id])

  @@index([invitedById, createdAt])
  @@map("shipment_invitations")
}

/// A personal follow-up a user sets on a shipment (#386). Private to its
/// creator; delivered once by ShipmentReminderJob when `remindAt` passes.
model ShipmentReminder {
  id         String    @id @default(uuid())
  shipmentId String
  userId     String
  remindAt   DateTime
  message    String
  sentAt     DateTime?
  createdAt  DateTime  @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user     User     @relation("ShipmentReminders", fields: [userId], references: [id], onDelete: Cascade)

  @@index([shipmentId, userId])
  @@index([sentAt, remindAt])
  @@map("shipment_reminders")
}

enum RecurringInterval {
  WEEKLY
  MONTHLY
}

/// Creates a draft shipment from a template on a fixed cadence (#389).
model RecurringSchedule {
  id          String            @id @default(uuid())
  ownerId     String
  templateId  String
  interval    RecurringInterval
  totalAmount BigInt            // stroops; templates carry no amount
  nextRunAt   DateTime
  lastRunAt   DateTime?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  owner    User             @relation("RecurringSchedules", fields: [ownerId], references: [id], onDelete: Cascade)
  template ShipmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([templateId])
  @@index([active, nextRunAt])
  @@map("recurring_schedules")
}

// ============================================================
// EMAIL SUPPRESSION (#434)
// ============================================================

enum EmailSuppressionReason {
  BOUNCE
  COMPLAINT
}

model EmailSuppression {
  id        String                 @id @default(uuid())
  email     String                 @unique // stored lower-cased
  reason    EmailSuppressionReason
  createdAt DateTime               @default(now())

  @@map("email_suppressions")
}

// ============================================================
// ORGANIZATIONS (#435)
// ============================================================

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator User                 @relation("OrganizationCreator", fields: [createdBy], references: [id])
  members OrganizationMember[]

  @@map("organizations")
}

model OrganizationMember {
  id        String           @id @default(uuid())
  orgId     String
  userId    String
  role      OrganizationRole @default(MEMBER)
  createdAt DateTime         @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
  @@map("organization_members")
}

